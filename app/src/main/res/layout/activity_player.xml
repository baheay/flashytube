<?xml version="1.0" encoding="utf-8"?>
<!-- Root is a FrameLayout so the fullscreen controls can overlay the video. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111">

    <!-- Video area (16:9 strip in portrait, full screen in fullscreen; set in code) -->
    <FrameLayout
        android:id="@+id/videoBox"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="#000000">

        <VideoView
            android:id="@+id/playerVideo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <ImageView
            android:id="@+id/playerThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/playerLoading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Subtitle overlay (bottom of video) -->
        <TextView
            android:id="@+id/playerSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="16dp"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:shadowColor="#CC000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:visibility="gone" />

        <!-- Gesture feedback OSD -->
        <com.ytgrab.app.PlayerGestureOverlay
            android:id="@+id/gestureOsd"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Unified overlay: controls float over the video (portrait + fullscreen) -->
    <FrameLayout
        android:id="@+id/playerOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- Top bar: back | pip + menu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="4dp">

            <ImageButton
                android:id="@+id/fsBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:contentDescription="back" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/fsSpeedTop"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="52dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:text="1x"
                android:textColor="#FFFFFF"
                android:shadowColor="#CC000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="4"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/fsPip"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_pip"
                android:scaleType="centerInside"
                android:padding="10dp"
                android:contentDescription="pip" />

            <ImageButton
                android:id="@+id/fsMenu"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_dots"
                android:scaleType="centerInside"
                android:padding="10dp"
                android:contentDescription="menu" />

        </LinearLayout>

        <!-- Center: prev | play | next -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/fsPrev"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_prev"
                android:scaleType="centerInside"
                android:padding="10dp"
                android:contentDescription="fsPrev" />

            <ImageButton
                android:id="@+id/fsPlay"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_play"
                android:scaleType="centerInside"
                android:padding="12dp"
                android:contentDescription="fsPlay" />

            <ImageButton
                android:id="@+id/fsNext"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_next"
                android:scaleType="centerInside"
                android:padding="10dp"
                android:contentDescription="fsNext" />

        </LinearLayout>

        <!-- Bottom: time | seekbar | time | fullscreen -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="12dp"
            android:paddingRight="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/fsCur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:shadowColor="#CC000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="4"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/fsSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp" />

            <TextView
                android:id="@+id/fsTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:shadowColor="#CC000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="4"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/fsQuality"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="4dp"
                android:text=""
                android:textColor="#FFFFFF"
                android:shadowColor="#CC000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="4"
                android:textSize="12sp"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/fsExit"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_fullscreen"
                android:scaleType="centerInside"
                android:padding="10dp"
                android:contentDescription="fsExit" />

        </LinearLayout>

    </FrameLayout>

    </FrameLayout>

    <!-- Portrait panel: everything below the video (topMargin set in code) -->
    <LinearLayout
        android:id="@+id/playerUi"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/playerTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="16sp"
            android:textStyle="bold" />




        <TextView
            android:id="@+id/queueHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/player_all_videos"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ListView
            android:id="@+id/queueList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:divider="?attr/colorDivider"
            android:dividerHeight="1dp" />

    </LinearLayout>


</FrameLayout>
