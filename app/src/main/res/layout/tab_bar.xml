<?xml version="1.0" encoding="utf-8"?>
<!-- SnapTube-style bottom tab bar. Included by the three main screens. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tabBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorDivider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="?attr/colorSurface"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tabDownload"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="6dp">

            <ImageView
                android:id="@+id/tabDownloadIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginBottom="2dp"
                android:src="@drawable/ic_tab_home" />

            <TextView
                android:id="@+id/tabDownloadLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_download"
                android:textSize="12sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabLibrary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="6dp">

            <ImageView
                android:id="@+id/tabLibraryIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginBottom="2dp"
                android:src="@drawable/ic_tab_download" />

            <TextView
                android:id="@+id/tabLibraryLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_library"
                android:textSize="12sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="6dp">

            <ImageView
                android:id="@+id/tabSettingsIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginBottom="2dp"
                android:src="@drawable/ic_tab_settings" />

            <TextView
                android:id="@+id/tabSettingsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_settings"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>
</LinearLayout>
