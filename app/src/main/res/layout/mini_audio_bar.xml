<?xml version="1.0" encoding="utf-8"?>
<!-- Compact audio mini-player bar: sits just above the tab bar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/miniBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorDivider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/colorSurfaceVariant"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/miniThumb"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerCrop" />

        <SeekBar
            android:id="@+id/miniSeek"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/miniSpeed"
            android:layout_width="52dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:minWidth="52dp"
            android:text="1x"
            android:textSize="13sp" />

        <Button
            android:id="@+id/miniPlay"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:minWidth="48dp"
            android:text="⏸"
            android:textSize="20sp" />

        <Button
            android:id="@+id/miniClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:minWidth="40dp"
            android:text="@string/mini_close"
            android:textSize="16sp" />

    </LinearLayout>
</LinearLayout>
