<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/libContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layoutDirection="locale"
        android:orientation="vertical"
        android:paddingTop="4dp">

        <!-- Sub-tabs as modern pill chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/subRunning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/subtab_running"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/subVideos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/subtab_videos"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/subAudio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/subtab_audio"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/subSubs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/subtab_subs"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/subFav"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="@string/subtab_favorites"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </HorizontalScrollView>

        <!-- Search + per-tab info/actions: counts for VIDEOS/AUDIO,
             icon actions for RUNNING (pause/resume/data) and FAVORITES (import/export) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/libSearch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/search_field_bg"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:padding="12dp"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="8dp"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/storageInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:gravity="end"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/hdrPauseAll"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/icon_btn_bg"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="⏸"
                    android:textSize="18sp"
                    android:textColor="?attr/colorOnSurface"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/hdrResumeAll"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/icon_btn_bg"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="▶"
                    android:textSize="18sp"
                    android:textColor="?attr/colorOnSurface"
                    android:visibility="gone" />



                <Button
                    android:id="@+id/hdrImportFav"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/icon_btn_bg"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="📥"
                    android:textSize="18sp"
                    android:textColor="?attr/colorOnSurface"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/hdrExportFav"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/icon_btn_bg"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="📤"
                    android:textSize="18sp"
                    android:textColor="?attr/colorOnSurface"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>





        <com.ytgrab.app.SwipeListView
            android:id="@+id/libList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:clipToPadding="false"
            android:paddingBottom="12dp"
            android:divider="@android:color/transparent"
            android:dividerHeight="0dp" />

        <LinearLayout
            android:id="@+id/libEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="56dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📥"
                android:textSize="52sp" />

            <TextView
                android:id="@+id/libEmptyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:text="@string/library_empty"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- Multi-select action bar (long-press a download to enter) -->
        <LinearLayout
            android:id="@+id/selBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/delSelBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:backgroundTint="?android:attr/colorPrimary"
                android:text="@string/del_selected"
                android:textColor="@android:color/white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/pauseSelBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="?attr/colorSurfaceVariant"
                android:text="@string/sel_pause"
                android:textSize="11sp"
                android:singleLine="true" />

            <Button
                android:id="@+id/resumeSelBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="?attr/colorSurfaceVariant"
                android:text="@string/sel_resume"
                android:textSize="11sp"
                android:singleLine="true" />

            <Button
                android:id="@+id/cancelSelBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="?attr/colorSurfaceVariant"
                android:textSize="11sp"
                android:singleLine="true"
                android:text="@string/btn_cancel" />

        </LinearLayout>

    </LinearLayout>

    <include layout="@layout/mini_audio_bar" />

    <include layout="@layout/tab_bar" />

</LinearLayout>
